# Copy to .env and fill in your credentials
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Trakt sign in uses the device-code flow, so only the client ID is needed (no client secret)
TRAKT_CLIENT_ID=replace-with-trakt-client-id
# Copy the Redirect URI exactly as it appears on your Trakt app. Sign in doesn't
# use it, but Trakt checks it when the server renews a sign-in (every ~6 days).
TRAKT_REDIRECT_URI=replace-with-your-trakt-app-redirect-uri
# Optional: skip the sign-in flow by pasting an existing token
# TRAKT_ACCESS_TOKEN=replace-with-trakt-access-token
# Increase if you want deeper history exclusion (max 10000)
TRAKT_HISTORY_LIMIT=1000
# Keep this in sync with the number of default catalog keys (currently 19)
CATALOG_COUNT=19
COMBINE_FOR_YOU_CATALOGS=false
REFRESH_INTERVAL=43200
CACHE_TTL=1800
